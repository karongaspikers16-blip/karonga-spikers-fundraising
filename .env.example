# Copy to .env.local for local development, and add the same two values in
# Vercel -> Project -> Settings -> Environment Variables. Rebuild after changing.
# Both are in Supabase -> Project Settings -> API. The anon key is safe to expose:
# what it can do is limited by the row level security in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
